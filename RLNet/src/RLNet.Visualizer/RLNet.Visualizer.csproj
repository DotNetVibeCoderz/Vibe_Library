<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RLNet.Visualizer</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />

    <!--
      Embeds Inter so the panel legends look the same on Windows, Linux and macOS. The design
      leans on a specific letterspaced grotesque; leaving it to whatever the host happens to have
      installed is how a considered layout turns into three different layouts.
    -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />

    <!--
      Pinned past Avalonia's transitive 0.21.2, which carries GHSA-xrw6-gwf8-vvr9. Only Avalonia's
      Linux backend touches D-Bus, so this affects the console alone and never RLNet.Core - but a
      build that reports a high-severity advisory trains people to ignore build warnings.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RLNet.Core/RLNet.Core.csproj" />
  </ItemGroup>

</Project>
