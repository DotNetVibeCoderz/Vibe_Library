<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ScrapyNet</RootNamespace>
    <AssemblyName>ScrapyNet.Core</AssemblyName>
  </PropertyGroup>

  <!--
    Published as Gravicode.ScrapyNet to match the other Gravicode packages. The assembly and every
    namespace stay ScrapyNet.*, so the prefix is only ever typed once, in a PackageReference.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Gravicode.ScrapyNet</PackageId>
    <Title>Scrapy.Net - web crawling and scraping framework for .NET</Title>
    <Description>A .NET 10 port of Scrapy: spiders, CSS/XPath selectors, items and item loaders, pipelines, feed exports (JSON, JSON Lines, CSV, XML), downloader and spider middlewares, retry, redirects, cookies, proxies, robots.txt, HTTP cache, AutoThrottle, duplicate filtering, pause/resume with a crash-safe disk queue, HTTP/2 and HTTP/3, spider contracts (scrapynet check), source-generated item accessors for NativeAOT, signals, stats and a Scrapy-style command line. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
    <PackageTags>scrapy;crawler;web-crawler;scraping;web-scraping;spider;xpath;css-selector;html;data-extraction</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="AngleSharp.XPath" Version="2.0.6" />
    <PackageReference Include="AngleSharp.Xml" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!--
    The [ScrapyItem] source generator travels inside this package as an analyzer. Built first, never
    referenced as a library.
  -->
  <ItemGroup>
    <ProjectReference Include="../ScrapyNet.Generators/ScrapyNet.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../ScrapyNet.Generators/bin/$(Configuration)/netstandard2.0/ScrapyNet.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScrapyNet.Tests" />
    <InternalsVisibleTo Include="ScrapyNet.Benchmarks" />
  </ItemGroup>

</Project>
