<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!--
    Attribution flows into every built assembly's metadata, so the credit travels with the
    binaries rather than living only in the README.
  -->
  <PropertyGroup>
    <Authors>Kang Fadhil (Gravicode Studios)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>APL.Net</Product>
    <Copyright>Copyright (c) 2026 Gravicode Studios. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CreatedBy" Value="Gravicode Studios" />
    <AssemblyMetadata Include="LedBy" Value="Kang Fadhil" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      The sources live in a subfolder of the Vibe_Library monorepo, so both URLs point at that
      subfolder. PublishRepositoryUrl stays off: it would let SourceLink overwrite RepositoryUrl with
      the bare git remote and drop the subfolder.
    -->
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Library/tree/main/APLNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Library/tree/main/APLNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Only the library packs; the generator ships inside it, and everything else opts out. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
