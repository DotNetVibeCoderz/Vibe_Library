<!--
    Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.

    The desktop samples' palette - indigo ground, brass accent, monospace for anything that names
    an actor or a node - at sizes a thumb can hit.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <SolidColorBrush x:Key="Ground" Color="#14161F" />
        <SolidColorBrush x:Key="Surface" Color="#1B1E29" />
        <SolidColorBrush x:Key="Raised" Color="#232735" />
        <SolidColorBrush x:Key="Line" Color="#2C3040" />
        <SolidColorBrush x:Key="Ink" Color="#E8E4DA" />
        <SolidColorBrush x:Key="Muted" Color="#868CA0" />
        <SolidColorBrush x:Key="Faint" Color="#5B6076" />
        <SolidColorBrush x:Key="Brass" Color="#E0A458" />
        <SolidColorBrush x:Key="Teal" Color="#4FB8A8" />
        <SolidColorBrush x:Key="Rose" Color="#E06A72" />

        <FontFamily x:Key="MonoFont">monospace</FontFamily>
    </Styles.Resources>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{StaticResource Ground}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LetterSpacing" Value="1.2" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The one action that changes what the node is. Brass marks it and nothing else. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Brass}" />
        <Setter Property="Foreground" Value="{StaticResource Ground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Brass}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource Ground}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Ground}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</Styles>
