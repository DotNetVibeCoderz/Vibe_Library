<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Microsoft.Data.SqlClient throws "Globalization Invariant Mode is not supported" on its first
      call, so the repository-wide InvariantGlobalization is turned off here. The property belongs
      to whichever executable is running, and this one talks to SQL Server; the library itself is
      unaffected either way. It only ever showed up in CI, because that is the only place the SQL
      Server suite has a server to run against.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>ActorNet.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      xunit.v3 runs on Microsoft.Testing.Platform, which the .NET 10 SDK no longer bridges to
      VSTest. The test project is its own executable and is run directly with "dotnet run".
    -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!--
      xUnit1051 wants TestContext.Current.CancellationToken threaded through every call. This
      suite is about timing behaviour - ask timeouts, idle sweeps, heartbeat deadlines - so it
      carries its own explicit deadlines (TestHarness.WaitForAsync and per-call timeouts), and a
      second ambient token on every line would obscure the one the test is actually asserting on.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ASP.NET Core integration is tested by standing a real app up on a loopback port. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ActorNet.Core/ActorNet.Core.csproj" />

    <!-- An analyzer reference is not transitive through a project reference, so the generator has
         to be named again here or the suite would compile without ever running it. -->
    <ProjectReference Include="../../src/ActorNet.Generators/ActorNet.Generators.csproj"
                     OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/ActorNet.AspNetCore/ActorNet.AspNetCore.csproj" />

    <!--
      Every persistence provider, so one conformance suite can run against all of them. SQLite and
      the two built-in stores always run; the server-backed ones self-skip unless their connection
      string is in the environment.
    -->
    <ProjectReference Include="../../src/ActorNet.Persistence.Sqlite/ActorNet.Persistence.Sqlite.csproj" />
    <ProjectReference Include="../../src/ActorNet.Persistence.SqlServer/ActorNet.Persistence.SqlServer.csproj" />
    <ProjectReference Include="../../src/ActorNet.Persistence.PostgreSql/ActorNet.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="../../src/ActorNet.Persistence.MySql/ActorNet.Persistence.MySql.csproj" />
    <ProjectReference Include="../../src/ActorNet.Persistence.Redis/ActorNet.Persistence.Redis.csproj" />
  </ItemGroup>

</Project>
