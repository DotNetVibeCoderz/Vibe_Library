<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ActorNet</RootNamespace>
    <AssemblyName>ActorNet.Core</AssemblyName>

    <!--
      The package id is the bare "ActorNet" the requirements ask for; it was unclaimed on
      nuget.org when this was set up. (The sibling RLNet project had to take a Gravicode.
      prefix because its bare id was already taken - that is not the case here.)
    -->
    <IsPackable>true</IsPackable>
    <PackageId>ActorNet</PackageId>
    <Description>A hybrid .NET actor framework: Orleans-style virtual actors with Akka-style supervision, clustering, persistence, event sourcing and reactive streams. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
    <PackageTags>actor;actor-model;virtual-actors;grains;distributed;cluster;supervision;event-sourcing;streams;orleans;akka</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The source generator, referenced as an analyzer rather than as a library: it runs inside the
      compiler and must not become a runtime dependency of anything that uses ActorNet.
    -->
    <ProjectReference Include="../ActorNet.Generators/ActorNet.Generators.csproj"
                     OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    And into the package under analyzers/dotnet/cs, which is where NuGet looks for one. Without
    this the generator would work for anyone building from source and for nobody who installs the
    package - the worst of both, because it would look like it worked.
  -->
  <Target Name="PackTheGenerator" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)../ActorNet.Generators/bin/$(Configuration)/netstandard2.0/ActorNet.Generators.dll"
            Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      So the suite can test internals that should not be public API - the challenge-response
      answer, for one. Exposing it publicly to make it testable would put an implementation detail
      in the package's surface forever.
    -->
    <InternalsVisibleTo Include="ActorNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Abstractions only. A library that forces a logging or DI implementation on its host is
      not "deep .NET integration", it is a conflict waiting to happen.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
