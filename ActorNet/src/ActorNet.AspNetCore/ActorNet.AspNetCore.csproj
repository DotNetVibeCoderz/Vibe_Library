<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ActorNet.AspNetCore</RootNamespace>
    <AssemblyName>ActorNet.AspNetCore</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>ActorNet.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for ActorNet: health checks that know what a node's cluster looks like, a readiness filter that keeps traffic off a node that is not serving, and read-only diagnostics endpoints.</Description>
    <PackageTags>actornet;actor-model;aspnetcore;health-checks;cluster</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ActorNet.Core/ActorNet.Core.csproj" />
  </ItemGroup>

</Project>
