<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    The wrapper lives on a hot render path (LVGL is an embedded-graphics library and one of the
    target devices is a Raspberry Pi), so the whole solution opts into the aggressive knobs by
    default. Server GC is deliberately OFF: it costs memory on a 1-4 GB board for no benefit here.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!--
    Attribution flows into every built assembly's metadata, so it travels with the
    binaries rather than living only in the README.
  -->
  <PropertyGroup>
    <Authors>Kang Fadhil (Gravicode Studios)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>LVGL.Net</Product>
    <Description>Multi-platform .NET wrapper for LVGL. Di port oleh Kang Fadhil dari Gravicode Studios.</Description>
    <Copyright>Di port oleh Kang Fadhil dari Gravicode Studios. LVGL itself is MIT-licensed.</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    NuGet metadata. The sources live in a subfolder of a shared repository, so both the project
    URL and the repository URL point at that subfolder rather than at the repository root.
  -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Library/tree/main/LVGL.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Library/tree/main/LVGL.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lvgl;embedded;graphics;gui;ui;raspberry-pi;iot;sdl;framebuffer;interop</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!--
      SourceLink is in the SDK. PublishRepositoryUrl stays off deliberately: it would let
      SourceLink overwrite RepositoryUrl above with the bare git remote, dropping the subfolder.
    -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    EnableDefaultNoneItems is off above, so the readme and licence the package metadata points at
    have to be listed by hand. Harmless in the non-packable projects: nothing packs there.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    A single generated attribution constant, available to every project, so the
    designer and the samples can show the credit without hard-coding the string.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="PortedBy" Value="Kang Fadhil" />
    <AssemblyMetadata Include="PortedByOrganization" Value="Gravicode Studios" />
  </ItemGroup>

</Project>
