<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    The wrapper lives on a hot render path (LVGL is an embedded-graphics library and one of the
    target devices is a Raspberry Pi), so the whole solution opts into the aggressive knobs by
    default. Server GC is deliberately OFF: it costs memory on a 1-4 GB board for no benefit here.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <!--
    Attribution flows into every built assembly's metadata, so it travels with the
    binaries rather than living only in the README.
  -->
  <PropertyGroup>
    <Authors>Kang Fadhil (Gravicode Studios)</Authors>
    <Company>Gravicode Studios</Company>
    <Product>LVGL.Net</Product>
    <Description>Multi-platform .NET wrapper for LVGL. Di port oleh Kang Fadhil dari Gravicode Studios.</Description>
    <Copyright>Di port oleh Kang Fadhil dari Gravicode Studios. LVGL itself is MIT-licensed.</Copyright>
    <RepositoryUrl>https://github.com/lvgl/lvgl</RepositoryUrl>
    <PackageProjectUrl>https://gravicode.com</PackageProjectUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    A single generated attribution constant, available to every project, so the
    designer and the samples can show the credit without hard-coding the string.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="PortedBy" Value="Kang Fadhil" />
    <AssemblyMetadata Include="PortedByOrganization" Value="Gravicode Studios" />
  </ItemGroup>

</Project>
