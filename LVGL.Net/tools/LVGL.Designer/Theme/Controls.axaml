<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Base ===================== -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Mask}" />
    <Setter Property="Foreground" Value="{StaticResource Silk}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource SilkDim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource SilkFaint}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
  </Style>

  <!-- Section heads: condensed, spaced capitals, like the labels on a board's edge. -->
  <Style Selector="TextBlock.head">
    <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource TextHead}" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{StaticResource SilkDim}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- Reference designators (BTN2, LBL1) and numbers: the only place the mono face appears. -->
  <Style Selector="TextBlock.designator">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextMono}" />
    <Setter Property="Foreground" Value="{StaticResource Copper}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextMono}" />
  </Style>

  <!-- ===================== Panels ===================== -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Board}" />
  </Style>
  <Style Selector="Border.panel-head">
    <Setter Property="Padding" Value="12,9,8,7" />
    <Setter Property="BorderBrush" Value="{StaticResource Trace}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.rule-top">
    <Setter Property="BorderBrush" Value="{StaticResource Trace}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Trace}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="7,1" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource Trace}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource Copper}" />
  </Style>

  <!-- ===================== Buttons ===================== -->

  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Trace}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The one filled button per surface: the action the user most likely wants next. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Copper}" />
    <Setter Property="BorderBrush" Value="{StaticResource Copper}" />
    <Setter Property="Foreground" Value="{StaticResource Mask}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CopperHot}" />
    <Setter Property="BorderBrush" Value="{StaticResource CopperHot}" />
    <Setter Property="Foreground" Value="{StaticResource Mask}" />
  </Style>

  <Style Selector="Button.ghost, ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <Style Selector="Button.ghost:disabled /template/ ContentPresenter, ToggleButton.ghost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SilkFaint}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Fault}" />
    <Setter Property="BorderBrush" Value="{StaticResource Fault}" />
  </Style>

  <!-- Toggles read "on" as a copper rule under the label rather than a filled block. -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CopperWash}" />
    <Setter Property="BorderBrush" Value="{StaticResource Copper}" />
    <Setter Property="Foreground" Value="{StaticResource Silk}" />
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource CopperHot}" />
  </Style>

  <!-- Design / Code: a segmented pair sharing one border. -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Seg" Background="Transparent" Padding="14,5" CornerRadius="{StaticResource RadiusSmall}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource SilkDim}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Silk}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{StaticResource Mask}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#Seg">
    <Setter Property="Background" Value="{StaticResource Copper}" />
  </Style>

  <!-- ===================== Inputs ===================== -->

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextMono}" />
  </Style>
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Fault}" />
  </Style>

  <!-- ===================== Lists and trees ===================== -->

  <Style Selector="ListBoxItem, TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- A selected row gets a copper bar on its left edge, like pin 1's marker. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CopperWash}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource CopperWash}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource TraceBright}" />
    <Setter Property="Foreground" Value="{StaticResource Silk}" />
    <Setter Property="FontSize" Value="{StaticResource TextSmall}" />
  </Style>

</Styles>
