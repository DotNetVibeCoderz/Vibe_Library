<UserControl x:Class="Lvgl.Designer.Editor.CodeEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="#FF11151C">

    <DockPanel>

        <!-- Editor toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeAlt}"
                BorderBrush="{StaticResource ChromeLine}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>

                <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource InkMuted}" FontSize="11" />
                <ComboBox x:Name="ViewBox" Width="150" SelectionChanged="OnViewChanged" VerticalAlignment="Center" />

                <Separator Width="10" Background="Transparent" />

                <Button Content="&#x21B6;" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" Padding="8,1" />
                <Button Content="&#x21B7;" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" Padding="8,1" />

                <Separator Width="8" Background="Transparent" />

                <Button Content="Cut" Click="OnCut" ToolTip="Cut (Ctrl+X)" Padding="7,1" />
                <Button Content="Copy" Click="OnCopy" ToolTip="Copy (Ctrl+C)" Padding="7,1" />
                <Button Content="Paste" Click="OnPaste" ToolTip="Paste (Ctrl+V)" Padding="7,1" />

                <Separator Width="8" Background="Transparent" />

                <Button Content="Find" Click="OnFind" ToolTip="Find and replace (Ctrl+F)" Padding="7,1" />
                <Button Content="Go to line" Click="OnGoToLine" ToolTip="Go to line (Ctrl+G)" Padding="7,1" />

                <Separator Width="8" Background="Transparent" />

                <CheckBox x:Name="LineNumbersToggle" Content="Line numbers" IsChecked="True"
                          Checked="OnLineNumbersChanged" Unchecked="OnLineNumbersChanged"
                          VerticalAlignment="Center" Foreground="{StaticResource Ink}"
                          FontSize="11" Margin="0,0,10,0" />

                <CheckBox x:Name="WordWrapToggle" Content="Wrap"
                          Checked="OnWordWrapChanged" Unchecked="OnWordWrapChanged"
                          VerticalAlignment="Center" Foreground="{StaticResource Ink}"
                          FontSize="11" Margin="0,0,10,0" />

                <!-- Right-aligned actions -->
                <Button DockPanel.Dock="Right" x:Name="ApplyButton" Content="Apply to design"
                        Click="OnApply" Margin="6,0,0,0" Padding="9,1"
                        Background="{StaticResource Accent}" Foreground="#FF0F1720"
                        ToolTip="Parse this JSON and replace the current layout (Ctrl+Enter)" />
                <Button DockPanel.Dock="Right" Content="Copy all" Click="OnCopyAll" Padding="7,1" Margin="0" />

                <TextBlock />
            </DockPanel>
        </Border>

        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeAlt}"
                BorderBrush="{StaticResource ChromeLine}" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="CaretText" Foreground="{StaticResource InkMuted}" FontSize="11" />
                <TextBlock x:Name="EditorStatus" Margin="14,0,0,0" Foreground="{StaticResource InkMuted}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <avalon:TextEditor x:Name="Editor"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           FontSize="13"
                           ShowLineNumbers="True"
                           Background="#FF0D1117"
                           Foreground="#FFE7EDF5"
                           LineNumbersForeground="#FF5A6472"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />

    </DockPanel>
</UserControl>
