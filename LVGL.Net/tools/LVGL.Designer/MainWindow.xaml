<Window x:Class="Lvgl.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Lvgl.Ui;assembly=LVGL.Net.Ui"
        xmlns:assistant="clr-namespace:Lvgl.Designer.Assistant"
        xmlns:editor="clr-namespace:Lvgl.Designer.Editor"
        Title="LVGL Designer - di port oleh Kang Fadhil (Gravicode Studios)"
        Height="800" Width="1280" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Chrome}"
        UseLayoutRounding="True">

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeAlt}" BorderBrush="{StaticResource ChromeLine}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <Button Content="New" Click="OnNew" />
                <Button Content="Open..." Click="OnOpen" />
                <Button Content="Save" Click="OnSave" />
                <Button Content="Save as..." Click="OnSaveAs" />
                <Button Content="Export C#..." Click="OnExportCSharp" />

                <Separator Width="12" Background="Transparent" />

                <!-- Design / Code mode -->
                <Border BorderBrush="{StaticResource ChromeLine}" BorderThickness="1" CornerRadius="4"
                        Padding="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DesignModeButton" Content="Design" GroupName="Mode"
                                     IsChecked="True" Checked="OnModeChanged"
                                     Style="{StaticResource ModeTab}" />
                        <RadioButton x:Name="CodeModeButton" Content="Code" GroupName="Mode"
                                     Checked="OnModeChanged"
                                     Style="{StaticResource ModeTab}" />
                    </StackPanel>
                </Border>

                <Separator Width="12" Background="Transparent" />

                <!-- Panel visibility -->
                <ToggleButton x:Name="ToolboxToggle" Content="Toolbox" IsChecked="True"
                              Checked="OnPanelToggled" Unchecked="OnPanelToggled"
                              Padding="9,4" Margin="0,0,4,0"
                              ToolTip="Show or hide the toolbox (Ctrl+B)" />
                <ToggleButton x:Name="InspectorToggle" Content="Inspector" IsChecked="True"
                              Checked="OnPanelToggled" Unchecked="OnPanelToggled"
                              Padding="9,4"
                              ToolTip="Show or hide the outline and properties (Ctrl+Shift+B)" />

                <Separator Width="12" Background="Transparent" />

                <TextBlock Text="Screen" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{StaticResource InkMuted}" />
                <TextBox x:Name="ScreenWidthBox" Width="58" TextChanged="OnScreenSizeChanged" />
                <TextBlock Text="x" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{StaticResource InkMuted}" />
                <TextBox x:Name="ScreenHeightBox" Width="58" TextChanged="OnScreenSizeChanged" />

                <!-- Assistant toggle, right-aligned -->
                <ToggleButton DockPanel.Dock="Right" x:Name="AssistantToggle" Content="Ask Jack"
                              Checked="OnAssistantToggled" Unchecked="OnAssistantToggled"
                              Padding="10,4" Margin="6,0,0,0"
                              ToolTip="Show or hide the design assistant (Ctrl+J)" />

                <TextBlock x:Name="DocumentStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{StaticResource InkMuted}" />

                <TextBlock />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeAlt}" BorderBrush="{StaticResource ChromeLine}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RevertButton" Content="Undo assistant change"
                        Click="OnRevertAssistantChange" Visibility="Collapsed" Padding="7,1" Margin="0" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMuted}" FontSize="11"
                           VerticalAlignment="Center" Text="Ready" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Main area: workspace + assistant -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="AssistantColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Workspace: toolbox | centre | inspector, each side collapsible -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ToolboxColumn" Width="170" />
                    <ColumnDefinition x:Name="ToolboxSplitterColumn" Width="4" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="4" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Toolbox -->
                <Border x:Name="ToolboxPanel" Grid.Column="0" Background="{StaticResource Chrome}"
                        BorderBrush="{StaticResource ChromeLine}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,4,0">
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Click="OnHideToolbox"
                                    Padding="6,0" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                                    ToolTip="Hide the toolbox (Ctrl+B)" />
                            <TextBlock Text="TOOLBOX" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <ListBox x:Name="ToolboxList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Ink}" Margin="6,0,6,8"
                                 MouseDoubleClick="OnToolboxDoubleClick" />
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="ToolboxSplitter" Grid.Column="1" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource ChromeLine}" />

                <!-- Inspector -->
                <Border x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource Chrome}"
                        BorderBrush="{StaticResource ChromeLine}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="240" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,4,0">
                                <Button DockPanel.Dock="Right" Content="&#x2715;" Click="OnHideInspector"
                                        Padding="6,0" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                                        ToolTip="Hide the inspector (Ctrl+Shift+B)" />
                                <TextBlock Text="OUTLINE" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,4,10,8">
                                <Button Content="Delete" Click="OnDeleteNode" />
                                <Button Content="Duplicate" Click="OnDuplicateNode" />
                            </StackPanel>
                            <TreeView x:Name="OutlineTree" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource Ink}" Margin="6,0"
                                      SelectedItemChanged="OnOutlineSelectionChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type ui:UiNode}" ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>

                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Top" Text="PROPERTIES" Style="{StaticResource SectionHeader}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,10,10">
                                <StackPanel x:Name="PropertyPanel" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource ChromeLine}" />

                <!-- Centre: preview or code -->
                <Grid Grid.Column="2">
                    <Grid x:Name="DesignSurface" Background="#FF11151C">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <Border BorderBrush="{StaticResource ChromeLine}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="PreviewImage" Stretch="None" SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Border x:Name="PreviewUnavailablePanel" Visibility="Collapsed"
                                Background="#E611151C" Padding="28">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                                <TextBlock Text="Live preview unavailable" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBlock x:Name="PreviewUnavailableText" TextWrapping="Wrap"
                                           Foreground="{StaticResource InkMuted}" FontFamily="Consolas" FontSize="12" />
                                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                                           Text="Editing, saving, code mode and C# export all work without it - only the rendered preview needs the native library." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <editor:CodeEditorPanel x:Name="CodeSurface" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <GridSplitter x:Name="AssistantSplitter" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource ChromeLine}" Visibility="Collapsed" />

            <assistant:ChatPanel x:Name="Assistant" Grid.Column="2" Visibility="Collapsed" />
        </Grid>

    </DockPanel>
</Window>
