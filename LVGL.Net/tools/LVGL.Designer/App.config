<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!--
      Jack The Code Bender - the design assistant built into the LVGL designer.
      LVGL.Net: di port oleh Kang Fadhil dari Gravicode Studios.

      API keys: an environment variable of the name shown below always wins over the value here,
      so you can leave the keys blank in this file and keep them out of source control.
    -->

    <add key="Assistant:Name" value="Jack The Code Bender" />

    <!-- OpenAI | Anthropic | Gemini | Ollama -->
    <add key="Assistant:Provider" value="OpenAI" />

    <!--
      Sampling temperature, 0 to 2.

      NOTE: Anthropic removed the sampling parameters on Claude Opus 5, Opus 4.8, Opus 4.7,
      Sonnet 5 and Fable 5 - sending a temperature to those models is rejected with HTTP 400.
      The Anthropic connector detects this and leaves the value out of the request rather than
      failing; the chat window tells you when that happens. Other providers use it normally.
    -->
    <add key="Assistant:Temperature" value="0.7" />

    <add key="Assistant:MaxTokens" value="4096" />

    <!-- How many previous turns are replayed to the model on each request. -->
    <add key="Assistant:HistoryTurnLimit" value="40" />

    <!-- Let the model call the built-in tools (search, scrape, design generation, ...). -->
    <add key="Assistant:EnableFunctionCalling" value="true" />

    <!-- Cap on automatic tool rounds before the assistant answers regardless. -->
    <add key="Assistant:MaxToolIterations" value="8" />

    <!-- Persona. Leave empty to use the built-in one, which knows this wrapper's pitfalls. -->
    <add key="Assistant:SystemPrompt" value="" />

    <!-- ============================ Providers ============================ -->

    <add key="Assistant:OpenAI:Model" value="gpt-4o" />
    <add key="Assistant:OpenAI:ApiKey" value="sk-proj-xxx" />       <!-- or OPENAI_API_KEY -->
    <add key="Assistant:OpenAI:Endpoint" value="https://api.openai.com/v1" />     <!-- optional, for a compatible gateway -->

    <add key="Assistant:Anthropic:Model" value="claude-opus-5" />
    <add key="Assistant:Anthropic:ApiKey" value="" />    <!-- or ANTHROPIC_API_KEY -->

    <add key="Assistant:Gemini:Model" value="gemini-2.0-flash" />
    <add key="Assistant:Gemini:ApiKey" value="" />       <!-- or GEMINI_API_KEY -->

    <!-- Ollama runs locally and needs no key; make sure the model is pulled first. -->
    <add key="Assistant:Ollama:Model" value="llama3.2" />
    <add key="Assistant:Ollama:Endpoint" value="http://localhost:11434" />

    <!-- ============================ Tools ============================ -->

    <!-- Web search. Leave empty to hide the search tool entirely. -->
    <add key="Assistant:TavilyApiKey" value="tvly-dev-xxx" />        <!-- or TAVILY_API_KEY -->

    <!-- ============================ Storage ============================ -->

    <!-- Defaults to %APPDATA%\LVGL.Net\assistant. -->
    <add key="Assistant:SessionDirectory" value="" />

    <!-- Port for the local attachment host; 0 picks a free one. -->
    <add key="Assistant:AttachmentPort" value="0" />

    <add key="Assistant:MaxAttachmentMegabytes" value="20" />

  </appSettings>
</configuration>
