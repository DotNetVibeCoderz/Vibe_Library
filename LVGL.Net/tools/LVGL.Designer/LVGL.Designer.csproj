<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Avalonia makes the designer cross-platform: it runs on Windows, macOS and Linux - including
      a Raspberry Pi desktop - from this one project. The LVGL preview is LVGL itself, rendered
      off-screen through HeadlessBackend, so it needs nothing platform-specific either.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lvgl.Designer</RootNamespace>
    <AssemblyName>LVGL.Designer</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>Assets/designer.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      Text shaping resolves cultures from the UI language; keep ICU available rather than
      inheriting the solution-wide invariant mode, which is meant for the embedded targets.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Directory.Build.props sets EnableDefaultNoneItems=false, which stops the SDK's default glob
    from picking App.config up - and the SDK only copies it to LVGL.Designer.dll.config when it
    is a None item. Without this the app starts fine and then reports "no API key" for every
    provider, because ConfigurationManager has no config file to read.
  -->
  <ItemGroup>
    <None Include="App.config" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LVGL.Net/LVGL.Net.csproj" />
    <ProjectReference Include="../../src/LVGL.Net.Ui/LVGL.Net.Ui.csproj" />
    <ProjectReference Include="../../src/LVGL.Net.Assistant/LVGL.Net.Assistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />

    <!-- The code view needs line numbers, search, undo/redo and highlighting: AvaloniaEdit has all four. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LVGL.Designer.Tests" />
  </ItemGroup>

</Project>
