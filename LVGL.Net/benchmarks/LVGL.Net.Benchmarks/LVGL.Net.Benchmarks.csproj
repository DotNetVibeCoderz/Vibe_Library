<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Allocation and timing benchmarks for the render and interop paths (principle 3 in PLAN.md).
    Run with: dotnet run -c Release (project benchmarks/LVGL.Net.Benchmarks)
    The zero-allocation property itself is enforced by a test (The_render_path_does_not_allocate);
    these give the numbers behind it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lvgl.Benchmarks</RootNamespace>
    <AssemblyName>LVGL.Net.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet's own code uses invariant-culture-sensitive APIs; keep ICU available. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LVGL.Net/LVGL.Net.csproj" />
  </ItemGroup>

</Project>
