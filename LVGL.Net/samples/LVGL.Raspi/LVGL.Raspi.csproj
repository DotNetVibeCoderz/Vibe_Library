<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lvgl.Samples.Raspi</RootNamespace>
    <AssemblyName>LVGL.Raspi</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- The Pi 4 is 64-bit; keep the published output small enough to copy over the network. -->
    <RuntimeIdentifiers>linux-arm64;linux-arm;linux-x64;win-x64</RuntimeIdentifiers>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LVGL.Net/LVGL.Net.csproj" />
    <ProjectReference Include="../../src/LVGL.Net.Linux/LVGL.Net.Linux.csproj" />
    <!-- Referenced so the dashboard can be developed in a window on a desktop machine. -->
    <ProjectReference Include="../../src/LVGL.Net.Sdl/LVGL.Net.Sdl.csproj" />
  </ItemGroup>

</Project>
